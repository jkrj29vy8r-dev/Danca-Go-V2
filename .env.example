# All variables below are optional. The site builds and the marketing pages
# render fully with none of them set — see README.md → "Deploying" for what
# degrades without each one.

# Supabase — Project Settings → API
# Without these: search, booking and rental-quote forms show their designed
# "not connected yet" fallback state instead of crashing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL — used for metadata, canonical links, the sitemap and the
# structured-data blocks. Without it: falls back to Vercel's own deployment
# URL, then to https://dancago.ro. Only needs setting once a custom domain
# is attached.
NEXT_PUBLIC_SITE_URL=https://dancago.ro

# Vercel Web Analytics and Speed Insights need no environment variable at
# all — they're wired into the root layout unconditionally (both no-op
# outside Vercel's own infrastructure) and start reporting the moment
# Analytics / Speed Insights is switched on in the Vercel project dashboard.
